# 비워두면(또는 이 줄을 지우면) frontend는 상대 경로(/api/...)로 요청하고,
# Vite dev server의 proxy(vite.config.js: /api, /health → http://127.0.0.1:8000)를 통해
# backend에 연결됩니다. iPhone 등 다른 기기에서 PC의 LAN 주소로 접속할 때도 그대로 동작합니다.
#
# frontend와 backend가 서로 다른 origin에 배포된 프로덕션 환경에서만 실제 주소를 지정하세요.
# 예: VITE_API_BASE_URL=https://ticket-to-tale-api.example.com
VITE_API_BASE_URL=

# 카카오 디벨로퍼스(developers.kakao.com) JavaScript 키. 카카오맵·카카오톡 공유 SDK에 쓴다.
# [앱] > [앱 키] > JavaScript 키. (다른 키들과 달리 이 키는 프론트엔드 코드에 그대로
# 노출되는 게 정상이다 — 카카오 콘솔의 웹 도메인 화이트리스트로 도메인 단위 제한을 건다.)
VITE_KAKAO_JS_KEY=
