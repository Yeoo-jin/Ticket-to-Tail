# AI 공급자 선택: gemini(기본, 무료 티어) 또는 anthropic
AI_PROVIDER=gemini

# Google Gemini API 키 (본인의 키를 로컬 .env에만 설정, 커밋 금지)
GEMINI_API_KEY=
# 사용할 Gemini 모델 이름 (미설정 시 기본값 gemini-3.6-flash 사용)
GEMINI_MODEL=gemini-3.6-flash

FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 공공데이터포털(data.go.kr) 서비스키. 항공(인천국제공항공사 항공기 운항 현황 상세 조회)과
# 철도(한국철도공사 열차운행정보) 둘 다 같은 계정 키를 공용으로 쓴다(API마다 별도 발급 아님).
# 마이페이지 > 오픈API > 개발계정에서 "일반 인증키(Decoding)" 값을 넣는다.
# (Encoding 버전을 넣으면 요청 시 다시 인코딩되어 이중 인코딩으로 인증 실패가 날 수 있음)
PUBLIC_DATA_API_KEY=

# 기상청 API허브(apihub.kma.go.kr) 인증키. 위 공공데이터포털 키와는 별도 발급.
# 단기예보 조회서비스(기상청API허브 연계) 신청 후 마이페이지에서 확인.
KMA_API_KEY=

# 카카오 디벨로퍼스(developers.kakao.com) REST API 키. 관광지 주소 → 좌표 변환(카카오
# 로컬 API)에 한 번 쓰는 용도라 서버에서만 사용한다. [앱] > [앱 키] > REST API 키.
# (지도·공유에 쓰는 JavaScript 키와는 다른 키이니 헷갈리지 않게 주의)
KAKAO_REST_API_KEY=
